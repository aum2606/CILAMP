# IAM ConCen Configuration — AWS Identity & Access Management Command Center
IAMCONCEN_MODE=SIMULATION

# Local runtime database
IAMCONCEN_DATABASE_PATH=data/cilamp.db

# AWS IAM Integration settings (Read-only, account-verified, allowlist scoped)
IAMCONCEN_AWS_LAB_ENABLED=false
IAMCONCEN_AWS_ACCOUNT_ID=
IAMCONCEN_AWS_ACCOUNT_LABEL=My AWS Lab
IAMCONCEN_AWS_REGION=ap-south-1
IAMCONCEN_AWS_PROFILE=
IAMCONCEN_AWS_ROLE_PATH=/iamconcen/
IAMCONCEN_AWS_ALLOWED_BUCKETS=
