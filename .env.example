# Safe default. LIVE_LAB is opt-in and requires the dedicated-lab guard below.
CILAMP_MODE=SIMULATION

# Optional. Relative paths are resolved from the repository root.
CILAMP_DATABASE_PATH=data/cilamp.db

# Phase 5 Microsoft Entra lab settings. Values below are non-secret controls.
CILAMP_ENTRA_LAB_ENABLED=false
CILAMP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
CILAMP_ENTRA_TENANT_LABEL=CILAMP Dedicated Lab
CILAMP_ENTRA_AUTH_METHOD=AZURE_CLI
CILAMP_ENTRA_WRITES_ENABLED=false
CILAMP_ENTRA_ALLOWED_USER_DOMAIN=cilamp-lab.example
CILAMP_ENTRA_ALLOWED_GROUP_IDS=00000000-0000-0000-0000-000000000000

# Phase 6 Azure Resource Manager discovery. Read-only and resource-group scoped.
CILAMP_AZURE_LAB_ENABLED=false
CILAMP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
CILAMP_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
CILAMP_AZURE_SUBSCRIPTION_LABEL=CILAMP Azure Lab
CILAMP_AZURE_RESOURCE_GROUP=rg-cilamp-lab
CILAMP_AZURE_AUTH_METHOD=AZURE_CLI

# Phase 7 AWS discovery. Read-only, account-verified, and allowlist scoped.
CILAMP_AWS_LAB_ENABLED=false
CILAMP_AWS_ACCOUNT_ID=123456789012
CILAMP_AWS_ACCOUNT_LABEL=CILAMP AWS Lab
CILAMP_AWS_REGION=ap-south-1
CILAMP_AWS_PROFILE=cilamp-lab-sso
CILAMP_AWS_ROLE_PATH=/cilamp/
CILAMP_AWS_ALLOWED_BUCKETS=cilamp-lab-development,cilamp-lab-reports

# Authenticate with `az login --tenant <tenant-id>` or a managed/workload identity.
# For AWS, prefer IAM Identity Center or an assume-role profile using temporary credentials.
# Never place client secrets, certificates, tokens, passwords, or AWS access keys in this file.
